# endif.tf configuration. Copy to .env; both binaries read it from the working directory
# (cargo run from the repo root). Production uses a different .env with the same keys: on
# sarahvps2 it is /srv/endif/.env (ENDIF_SIGNALING=wss://endif.tf, ENDIF_HOST=127.0.0.1 behind
# nginx, ENDIF_TRUST_PROXY=true, the MariaDB `endif` user), symlinked into the deploy checkout by
# .github/workflows/deploy.yml.
#
# The web build cannot read files at run time: build-web.sh exports this file into the build, so
# the ENDIF_* values below are compiled into the wasm (and the page).

# ---------------------------------------------------------------- shared (client + server)
# Signaling / matchmaking / account server the client talks to. ws:// for dev, wss:// in prod.
ENDIF_SIGNALING=ws://127.0.0.1:3536
# HTTP base of the account API. Leave empty to derive it from ENDIF_SIGNALING (ws -> http).
ENDIF_API=
# ICE servers, comma separated: stun:host:port or turn:host:port|user|password. Empty = built-in default.
ENDIF_ICE=

# ---------------------------------------------------------------- server
# Address the server binds.
ENDIF_HOST=0.0.0.0
ENDIF_PORT=3536
# Peers per room (2 for a 1v1).
ENDIF_MAX_ROOM_SIZE=2
# Log filter (tracing_subscriber EnvFilter syntax).
RUST_LOG=info,sqlx=warn
# Rate limits: leaky buckets per client address (README, "Rate limits"). false only for local load tests.
ENDIF_RATE_LIMITS=true
# Behind a reverse proxy that sets X-Forwarded-For / X-Real-IP, key the buckets by that address
# instead of the proxy's. Never true without such a proxy in front: clients could pick their own bucket.
ENDIF_TRUST_PROXY=false
# Verification / reset mails the whole server sends per day at most (Resend's free plan allows 100).
ENDIF_MAIL_PER_DAY=90

# MariaDB / MySQL (docker-compose.yml starts one with these credentials).
DATABASE_URL=mysql://root:pawsword@127.0.0.1:3306/endif
# Secret for signing login tokens (JWT HS256). Any long random string; changing it logs everyone out.
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# How long a login stays valid, in days.
JWT_DAYS=30

# Verification / password reset mails go through the Resend API (https://resend.com).
# "log" prints the codes to the server log instead of sending anything (dev). "resend" sends them.
MAIL_MODE=log
# API key from https://resend.com/api-keys (starts with re_). Required when MAIL_MODE=resend.
RESEND_API_KEY=
# Sender; the domain must be verified in Resend (see README, "E-mail"). Values with spaces
# must be double-quoted: an unquoted space ends the value and dotenv stops reading the file there.
MAIL_FROM="endif.tf <game@endif.tf>"
# Optional Reply-To, e.g. your own address, so replies to the codes reach you.
MAIL_REPLY_TO=
